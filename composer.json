{
  "name": "exin/exin-black-friday",
  "description": "EXIN Black Friday WooCommerce campaign plugin",
  "license": "GPL-2.0-or-later",
  "require": {"php": ">=8.1"},
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.3",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
  },
  "config": {"allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true}},
  "scripts": {
    "lint": "phpcs --standard=phpcs.xml.dist",
    "test:unit": "php tests/unit/run.php",
    "test:integration": "bash scripts/test-runtime.sh test",
    "test:package": "python3 tests/test_package.py"
  }
}
